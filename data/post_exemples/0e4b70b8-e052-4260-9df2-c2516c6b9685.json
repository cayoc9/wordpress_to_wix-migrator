                        }
                    },
                    {
                        "type": "TEXT",
                        "id": "",
                        "nodes": [],
                        "textData": {
                            "text": "alguma possibilidade de encontrar ele fora do ar nesse fim de outubro, mais precisamente no dia 30 de outubro. Alerta este, feito pelo próprio SEBRAE, onde informa que o ",
                            "decorations": []
                        }
